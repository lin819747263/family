# 服务器端口
PORT=3000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=family_home
DB_USER=root
DB_PASSWORD=your_password_here
DB_CHARSET=utf8mb4

# JWT 密钥（请使用随机生成的强密钥）
JWT_SECRET=your_jwt_secret_here

# 文件上传目录
UPLOAD_DIR=./uploads

# 阿里云 OSS 配置（可选）
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=

# 数据加密密钥（32位字符串，请使用随机生成的强密钥）
ENCRYPT_KEY=your_encrypt_key_here

# 运行环境：development / production
NODE_ENV=development

# 前端 URL（生产环境 CORS 配置）
# FRONTEND_URL=http://your-domain.com
